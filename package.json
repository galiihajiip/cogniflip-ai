{
  "name": "cogniflip",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-runtimes.mts",
    "dev": "next dev",
    "prebuild": "node scripts/copy-runtimes.mts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:reset-local": "docker compose down --volumes",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db.mts migrate",
    "db:status": "node --env-file-if-exists=.env.local scripts/db.mts status",
    "db:new": "node scripts/db.mts new",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "benchmark": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.benchmark.config.mts",
    "smoke": "node scripts/smoke.mts"
  },
  "dependencies": {
    "@google/genai": "2.25.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "pyodide": "0.29.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sql.js": "1.14.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.16.0"
}
