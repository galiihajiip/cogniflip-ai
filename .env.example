# Placeholder only. Never commit real credentials.
# Copy to .env.local for local development. Blank values count as "not set".
# Integrations are all-or-nothing: set every variable in a group or none.
# Validation lives in src/server/config/env.ts (server-only).

# ---------------------------------------------------------------------------
# App (server-only). Required in production.
APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# PUBLIC — inlined into the browser bundle at build time. Never put secrets here.
# (none needed yet)

# ---------------------------------------------------------------------------
# SERVER-ONLY SECRETS — never prefix with NEXT_PUBLIC_.

# Database group: PostgreSQL connection string (postgres:// or postgresql://).
# Local Docker database (see db/README.md):
#   postgresql://cogniflip:cogniflip_local_only@127.0.0.1:54329/cogniflip
# Production with a remote host must add ?sslmode=require (or verify-ca / verify-full).
DATABASE_URL=
# DATABASE_POOL_MAX: default 5, max 20
# DATABASE_CONNECT_TIMEOUT_MS: default 5000, max 30000
# DATABASE_STATEMENT_TIMEOUT_MS: default 5000, max 60000
DATABASE_POOL_MAX=
DATABASE_CONNECT_TIMEOUT_MS=
DATABASE_STATEMENT_TIMEOUT_MS=

# AI group (D-008). LLM_PROVIDER allowed values: gemini
# LLM_MODEL example: gemini-3.8-flash (final choice after the benchmark, ADR-007)
# Use a PAID Gemini tier: free-tier content is used by Google to improve products.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Optional backup models (comma-separated) used when LLM_MODEL is overloaded.
LLM_FALLBACK_MODELS=
# Deterministic mock AI for local development only (refused in production).
# Responses are labelled as mock and never presented as real AI.
AI_MOCK_MODE=
# Kill switch: AI_DISABLED=true stops every AI call (status shows "disabled").
AI_DISABLED=
# Draft (unreviewed) lessons and missions are shown by default (D-013).
# Set to false to show only published content.
ALLOW_DRAFT_CONTENT=

# Speech-to-text group
STT_PROVIDER=
STT_API_KEY=

# Text-to-speech group
TTS_PROVIDER=
TTS_API_KEY=

# Code runner group (https required in production)
CODE_RUNNER_PROVIDER=
CODE_RUNNER_BASE_URL=
CODE_RUNNER_API_KEY=

# Optional error reporting
ERROR_REPORTING_DSN=

# ---------------------------------------------------------------------------
# Limits (server-only). Blank uses the default; values are whole numbers.
# AI_MAX_REQUESTS_PER_MINUTE: default 10, max 600
# AI_MAX_CALLS_PER_SESSION:   default 6, max 50
# AI_TIMEOUT_SECONDS:         default 30, max 120
# CODE_RUN_MAX_SECONDS:       default 5, max 30
# CODE_RUN_MAX_OUTPUT_BYTES:  default 65536, max 1048576
AI_MAX_REQUESTS_PER_MINUTE=
AI_MAX_CALLS_PER_SESSION=
AI_TIMEOUT_SECONDS=
CODE_RUN_MAX_SECONDS=
CODE_RUN_MAX_OUTPUT_BYTES=
